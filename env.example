# Copiar a .env.local y completar

# Supabase (proyecto cloud — cuenta TM Soluciones Digitales)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Mercado Pago — Access Token (producción o prueba)
MP_ACCESS_TOKEN=APP_USR-...
# Secret de firma del webhook (opcional pero recomendado, se configura en
# "Tus integraciones" → Webhooks del panel de desarrolladores de MP)
MP_WEBHOOK_SECRET=

# URL pública del sitio (MP la usa para volver y para el webhook)
# En dev podés usar ngrok/similar si querés probar el webhook local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notificaciones por mail al barbero (SMTP de Gmail)
# GMAIL_USER: cuenta Gmail que envía los avisos
# GMAIL_APP_PASSWORD: "contraseña de aplicación" de esa cuenta
#   (myaccount.google.com → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones)
# NOTIFY_EMAIL: casilla que recibe el aviso de cada turno confirmado
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL=
